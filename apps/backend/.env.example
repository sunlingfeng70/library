PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_USER=library
DB_PASSWORD=library
DB_NAME=library

# 生产环境必须覆盖，否则使用开发默认值
JWT_SECRET=dev-only-secret

# 微信小程序（可选，配置后启用真实 code2session；未配置时注入 fake）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ISBN 补全：公开书目源（Open Library 兼容）
ISBN_LOOKUP_URL=https://openlibrary.org/api/books

# AI 阅读标签建议（Ollama 兼容 OpenAI /v1/chat/completions 端点）
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:3b